# At least one of these is required. Priority when more than one is set:
# OpenRouter > Google AI Studio > MiniMax.
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
MINIMAX_API_KEY=

# Optional overrides.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
GOOGLE_AI_STUDIO_MODEL=gemini-3.6-flash
MINIMAX_MODEL=MiniMax-M3

# Response token budget per provider. Reasoning-capable models spend
# hidden "thinking" tokens out of this same budget before any visible
# content, so too low a value can produce an empty or cut-off response —
# MiniMax's M3 family needs a much bigger one than the rest.
# 200000 is MiniMax's documented maximum for non-M3 models; the M3 family
# allows up to 524288. Raising this above the model's ceiling can get the
# request rejected instead of granting more output.
OPENROUTER_MAX_TOKENS=8192
GOOGLE_AI_STUDIO_MAX_TOKENS=8192
MINIMAX_MAX_TOKENS=200000

# Retry policy for a single chat completion. Providers under load often
# return 503 "high demand, try again later" that clears within seconds,
# so the app retries those automatically before giving up.
# MAX_ATTEMPTS counts total attempts (1 disables retrying; 3 = the call
# plus two retries). Delays grow exponentially: BASE_DELAY, 2x, 4x,
# capped at MAX_DELAY. Only transient statuses are retried (408, 429,
# 5xx, 529) — a 400 or 401 fails immediately no matter what these say.
PDF_READER_LLM_MAX_ATTEMPTS=3
PDF_READER_LLM_RETRY_BASE_DELAY=1.5
PDF_READER_LLM_RETRY_MAX_DELAY=20

# Where the SQLite DB and any URL-downloaded PDFs are cached.
# Default: ~/.local/share/custom-pdf-reader
PDF_READER_DATA_DIR=

# UI preferences.
# PDF_READER_DARK_MODE=0  start in light mode (dark is the default; toggleable from the toolbar).
